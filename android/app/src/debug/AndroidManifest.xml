<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      FR-12 AC3 (chan so an danh) - khai bao TestConnectionService (MANAGED ConnectionService,
      KHONG self-managed, KHONG MANAGE_OWN_CALLS - xem comment chi tiet trong
      android/app/src/debug/kotlin/com/safecall/callscreening/TestConnectionService.kt).
      Chi dung lam harness cho AnonymousCallBlockingInstrumentedTest: tiem cuoc goi vao Telecom
      framework THUC tren AVD/thiet bi, buoc Telecom goi dung qua pipeline CallScreeningService
      cua SafeCall (khong mock, khong qua modem/RIL gia lap).

      Dat trong source set `debug` (KHONG phai `androidTest`): `registerPhoneAccount()` chay duoi
      UID cua app "com.safecall" (instrumentation chay long vao process app duoc test), nen
      ComponentName cua PhoneAccount PHAI thuoc package "com.safecall" de Telecom khong tu choi
      bang SecurityException "enforcePhoneAccountModificationForPackage". Source set `debug`
      khong bao gio duoc merge vao build release.
    -->
    <application>
        <service
            android:name="com.safecall.callscreening.TestConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
